      "file": "c004.ogg",
      "durationSec": 31.0,
      "silence": true
    },
    {
      "index": 5,
      "text": "Suchen Sie nach Wärme, Vibration oder stiller Müdigkeit.",
      "file": "c005.ogg",
      "durationSec": 7.44
    },
    {
      "index": 6,
      "text": "Keine Benotung. Merke es einfach.",
      "file": "c006.ogg",
      "durationSec": 6.816
    },
    {
      "index": 7,
      "text": "[Pause:45]",
      "file": "c007.ogg",
      "durationSec": 45.0,
      "silence": true
    },
    {
      "index": 8,
      "text": "Lang ausatmen.",
      "file": "c008.ogg",
      "durationSec": 3.528
    },
    {
      "index": 9,
