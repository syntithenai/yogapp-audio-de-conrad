  "totalSec": 671,
  "chunks": [
    {
      "index": 0,
      "text": "Willkommen.",
      "file": "c000.ogg",
      "durationSec": 2.976
    },
    {
      "index": 1,
      "text": "Nehmen Sie sich Zeit zum Ankommen.",
      "file": "c001.ogg",
      "durationSec": 4.872
    },
    {
      "index": 2,
      "text": "Setzen oder legen Sie sich mit Unterstützung hin.",
      "file": "c002.ogg",
      "durationSec": 5.952
    },
    {
      "index": 3,
      "text": "Schließen Sie die Augen, wenn sich das sicher anfühlt.",
      "file": "c003.ogg",
      "durationSec": 6.24
    },
    {
      "index": 4,
      "text": "Spüren Sie den Kontakt mit dem Boden.",
      "file": "c004.ogg",
      "durationSec": 5.064
    },
    {
      "index": 5,
      "text": "Langsam einatmen.",
      "file": "c005.ogg",
      "durationSec": 3.792
    },
    {
      "index": 6,
      "text": "Längeres Ausatmen.",
      "file": "c006.ogg",
      "durationSec": 3.96
    },
    {
      "index": 7,
      "text": "[Pause:21]",
      "file": "c007.ogg",
      "durationSec": 21.0,
      "silence": true
    },
    {
      "index": 8,
      "text": "Wieder.",
      "file": "c008.ogg",
      "durationSec": 2.592
    },
    {
      "index": 9,
      "text": "[Pause:21]",
      "file": "c009.ogg",
      "durationSec": 21.0,
      "silence": true
    },
    {
      "index": 10,
      "text": "Lassen Sie die Schultern fallen.",
      "file": "c010.ogg",
      "durationSec": 4.368
    },
    {
      "index": 11,
      "text": "Lassen Sie den Bauch weich werden.",
      "file": "c011.ogg",
      "durationSec": 4.68
    },
    {
      "index": 12,
      "text": "[Pause:27]",
      "file": "c012.ogg",
      "durationSec": 27.0,
      "silence": true
    },
    {
      "index": 13,
      "text": "Beginnen Sie am Scheitel des Kopfes.",
      "file": "c013.ogg",
      "durationSec": 4.92
    },
    {
      "index": 14,
      "text": "Beachten Sie die Empfindung oder deren Fehlen.",
      "file": "c014.ogg",
      "durationSec": 5.808
    },
    {
      "index": 15,
      "text": "[Pause:27]",
      "file": "c015.ogg",
      "durationSec": 27.0,
      "silence": true
    },
    {
      "index": 16,
      "text": "Stirn. Augen. Wangen. Kiefer.",
      "file": "c016.ogg",
      "durationSec": 9.792
    },
    {
      "index": 17,
      "text": "Lassen Sie das Gesicht ein wenig schmelzen.",
      "file": "c017.ogg",
      "durationSec": 5.544
    },
    {
      "index": 18,
      "text": "[Pause:27]",
      "file": "c018.ogg",
      "durationSec": 27.0,
      "silence": true
    },
    {
      "index": 19,
      "text": "Kehle. Nacken. Schultern.",
      "file": "c019.ogg",
      "durationSec": 7.632
    },
    {
      "index": 20,
      "text": "Laden Sie die Schultern zum Senken ein.",
      "file": "c020.ogg",
      "durationSec": 5.304
    },
    {
      "index": 21,
      "text": "[Pause:32]",
      "file": "c021.ogg",
      "durationSec": 32.0,
      "silence": true
    },
    {
      "index": 22,
      "text": "Waffen. Ellenbogen. Handgelenke. Hände. Finger.",
      "file": "c022.ogg",
      "durationSec": 13.056
    },
    {
      "index": 23,
      "text": "[Pause:32]",
      "file": "c023.ogg",
      "durationSec": 32.0,
      "silence": true
    },
    {
      "index": 24,
      "text": "Heben und Senken der Brust.",
      "file": "c024.ogg",
      "durationSec": 4.176
    },
    {
      "index": 25,
      "text": "Herzraum weich.",
      "file": "c025.ogg",
      "durationSec": 3.264
    },
    {
      "index": 26,
      "text": "[Pause:27]",
      "file": "c026.ogg",
      "durationSec": 27.0,
      "silence": true
    },
    {
      "index": 27,
      "text": "Bauch. Niedriger Rücken. Hüften.",
      "file": "c027.ogg",
      "durationSec": 7.968
    },
    {
      "index": 28,
      "text": "[Pause:32]",
      "file": "c028.ogg",
      "durationSec": 32.0,
      "silence": true
    },
    {
      "index": 29,
      "text": "Schenkel. Knie. Kälber. Knöchel. Füße. Zehen.",
      "file": "c029.ogg",
      "durationSec": 14.64
    },
    {
      "index": 30,
      "text": "[Pause:38]",
      "file": "c030.ogg",
      "durationSec": 38.0,
      "silence": true
    },
    {
      "index": 31,
      "text": "Spüren Sie den ganzen Körper als ein Feld.",
      "file": "c031.ogg",
      "durationSec": 5.664
    },
    {
      "index": 32,
      "text": "Der Atem bewegt sich hindurch.",
      "file": "c032.ogg",
      "durationSec": 4.296
    },
    {
      "index": 33,
      "text": "[Pause:54]",
      "file": "c033.ogg",
      "durationSec": 54.0,
      "silence": true
    },
    {
      "index": 34,
      "text": "Wenn eine angespannte Stelle verbleibt, atmen Sie dorthin aus.",
      "file": "c034.ogg",
      "durationSec": 7.512
    },
    {
      "index": 35,
      "text": "[Pause:43]",
      "file": "c035.ogg",
      "durationSec": 43.0,
      "silence": true
    },
    {
      "index": 36,
      "text": "Ruhen Sie im Ganzkörperbewusstsein.",
      "file": "c036.ogg",
      "durationSec": 5.16
    },
    {
      "index": 37,
      "text": "[Pause:81]",
      "file": "c037.ogg",
      "durationSec": 81.0,
      "silence": true
    },
    {
      "index": 38,
      "text": "[Pause:32]",
      "file": "c038.ogg",
      "durationSec": 32.0,
      "silence": true
    },
    {
      "index": 39,
      "text": "Beginnen Sie, den Atem zu vertiefen.",
      "file": "c039.ogg",
      "durationSec": 5.472
    },
    {
      "index": 40,
      "text": "Spüren Sie den Raum noch einmal.",
      "file": "c040.ogg",
      "durationSec": 4.704
    },
    {
      "index": 41,
      "text": "Wackeln Sie mit Fingern und Zehen.",
      "file": "c041.ogg",
      "durationSec": 4.704
    },
    {
      "index": 42,
      "text": "Wenn Sie fertig sind, öffnen Sie die Augen.",
      "file": "c042.ogg",
      "durationSec": 5.736
    },
    {
      "index": 43,
      "text": "Gehen Sie langsam auf das ein, was als nächstes kommt.",
      "file": "c043.ogg",
      "durationSec": 6.816
    }
  ]
}
