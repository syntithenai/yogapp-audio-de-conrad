  "totalSec": 152,
  "chunks": [
    {
      "index": 0,
      "text": "Diese Übung ist für den Abschluss des Tages gedacht.",
      "file": "c000.ogg",
      "durationSec": 6.264
    },
    {
      "index": 1,
      "text": "Dimmen Sie das Licht, wenn Sie können.",
      "file": "c001.ogg",
      "durationSec": 4.968
    },
    {
      "index": 2,
      "text": "Legen Sie sich mit Unterstützung hin oder lehnen Sie sich zurück.",
      "file": "c002.ogg",
      "durationSec": 7.152
    },
    {
      "index": 3,
      "text": "Lassen Sie den Tag ausklingen, auch wenn der Kopf noch Aufgaben auflistet.",
      "file": "c003.ogg",
      "durationSec": 8.688
    },
    {
      "index": 4,
      "text": "Sie können sie vorerst ablegen.",
      "file": "c004.ogg",
      "durationSec": 4.8
    },
    {
      "index": 5,
      "text": "Atmen Sie sanft ein und zählen Sie dabei bis vier.",
      "file": "c005.ogg",
      "durationSec": 6.312
    },
    {
      "index": 6,
      "text": "Atme aus und zähle bis sechs.",
      "file": "c006.ogg",
      "durationSec": 4.656
    },
    {
      "index": 7,
      "text": "Wieder. Vier rein. Sechs raus.",
      "file": "c007.ogg",
      "durationSec": 8.184
    },
    {
      "index": 8,
      "text": "Längeres Ausatmen signalisiert dem Körper, dass es sicher ist, sich auszuruhen.",
      "file": "c008.ogg",
      "durationSec": 9.528
    },
    {
      "index": 9,
      "text": "Suchen Sie nach verbleibenden Spannungen im Gesicht.",
      "file": "c009.ogg",
      "durationSec": 5.976
    },
    {
      "index": 10,
      "text": "Machen Sie die Braue weicher. Machen Sie den Kiefer weich.",
      "file": "c010.ogg",
      "durationSec": 8.256
    },
    {
      "index": 11,
      "text": "Lassen Sie die Schultern von den Ohren wegfallen.",
      "file": "c011.ogg",
      "durationSec": 5.832
    },
    {
      "index": 12,
      "text": "Stellen Sie sich vor, der Tag würde sich wie Staub nach einer Brise legen.",
      "file": "c012.ogg",
      "durationSec": 8.424
    },
    {
      "index": 13,
      "text": "Was passiert ist, ist passiert.",
      "file": "c013.ogg",
      "durationSec": 5.136
    },
    {
      "index": 14,
      "text": "Was übrig bleibt, kann bis zum Morgen warten.",
      "file": "c014.ogg",
      "durationSec": 6.336
    },
    {
      "index": 15,
      "text": "Spüren Sie, wie die Matratze oder der Boden Sie halten.",
      "file": "c015.ogg",
      "durationSec": 6.888
    },
    {
      "index": 16,
      "text": "Ruhiger atmen. Körper schwerer.",
      "file": "c016.ogg",
      "durationSec": 6.504
    },
    {
      "index": 17,
      "text": "Wenn der Schlaf kommt, lass ihn.",
      "file": "c017.ogg",
      "durationSec": 5.016
    },
    {
      "index": 18,
      "text": "Wenn nicht, ruhen Sie sich trotzdem in dieser Weichheit aus.",
      "file": "c018.ogg",
      "durationSec": 7.128
    },
    {
      "index": 19,
      "text": "Drei weitere langsame Atemzüge.",
      "file": "c019.ogg",
      "durationSec": 5.16
    },
    {
      "index": 20,
      "text": "In. Aus.",
      "file": "c020.ogg",
      "durationSec": 4.368
    },
    {
      "index": 21,
      "text": "In. Aus.",
      "file": "c021.ogg",
      "durationSec": 4.368
    },
    {
      "index": 22,
      "text": "In. Aus.",
      "file": "c022.ogg",
      "durationSec": 4.368
    },
    {
      "index": 23,
      "text": "Gute Nacht für den Tag. Frieden für die Nacht.",
      "file": "c023.ogg",
      "durationSec": 7.272
    }
  ]
