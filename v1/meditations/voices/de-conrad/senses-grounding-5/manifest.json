{
  "id": "senses-grounding-5",
  "voiceId": "de-conrad",
  "edgeVoice": "de-DE-ConradNeural",
  "rate": "-42%",
  "pitch": "-12Hz",
  "totalSec": 330,
  "chunks": [
    {
      "index": 0,
      "text": "Willkommen.",
      "file": "c000.ogg",
      "durationSec": 2.976
    },
    {
      "index": 1,
      "text": "Wenn Sie sich zerstreut oder aktiviert fühlen, kann diese Übung hilfreich sein.",
      "file": "c001.ogg",
      "durationSec": 9.072
    },
    {
      "index": 2,
      "text": "Halten Sie vorerst die Augen offen, wenn sich das sicherer anfühlt.",
      "file": "c002.ogg",
      "durationSec": 7.536
    },
    {
      "index": 3,
      "text": "Stellen Sie beide Füße auf den Boden.",
      "file": "c003.ogg",
      "durationSec": 5.088
    },
    {
      "index": 4,
      "text": "[Pause:17]",
      "file": "c004.ogg",
      "durationSec": 17.0,
      "silence": true
    },
    {
      "index": 5,
      "text": "Nennen Sie fünf Dinge, die Sie sehen können.",
      "file": "c005.ogg",
      "durationSec": 5.784
    },
    {
      "index": 6,
      "text": "Ruhig. Nehmen Sie sich Zeit.",
      "file": "c006.ogg",
      "durationSec": 6.048
    },
    {
      "index": 7,
      "text": "[Pause:45]",
      "file": "c007.ogg",
      "durationSec": 45.0,
      "silence": true
    },
    {
      "index": 8,
      "text": "Nennen Sie vier Dinge, die Sie fühlen oder berühren können.",
      "file": "c008.ogg",
      "durationSec": 6.984
    },
    {
      "index": 9,
      "text": "Kleidung. Stuhl. Luft auf der Haut. Füße auf dem Boden.",
      "file": "c009.ogg",
      "durationSec": 12.0
    },
    {
      "index": 10,
      "text": "[Pause:39]",
      "file": "c010.ogg",
      "durationSec": 39.0,
      "silence": true
    },
    {
      "index": 11,
      "text": "Nennen Sie drei Laute.",
      "file": "c011.ogg",
      "durationSec": 3.864
    },
    {
      "index": 12,
      "text": "Nah oder fern. Weich oder klar.",
      "file": "c012.ogg",
      "durationSec": 6.768
    },
    {
      "index": 13,
      "text": "[Pause:39]",
      "file": "c013.ogg",
      "durationSec": 39.0,
      "silence": true
    },
    {
      "index": 14,
      "text": "Nennen Sie zwei Düfte oder nehmen Sie einfach die Qualität der Luft wahr.",
      "file": "c014.ogg",
      "durationSec": 8.232
    },
    {
      "index": 15,
      "text": "[Pause:28]",
      "file": "c015.ogg",
      "durationSec": 28.0,
      "silence": true
    },
    {
      "index": 16,
      "text": "Nennen Sie einen Geschmack oder das Gefühl im Mund.",
      "file": "c016.ogg",
      "durationSec": 5.856
    },
    {
      "index": 17,
      "text": "[Pause:23]",
      "file": "c017.ogg",
      "durationSec": 23.0,
      "silence": true
    },
    {
      "index": 18,
      "text": "Sie sind hier. In diesem Körper. In diesem Raum.",
      "file": "c018.ogg",
      "durationSec": 9.24
    },
    {
      "index": 19,
      "text": "Atme zu viert ein.",
      "file": "c019.ogg",
      "durationSec": 3.648
    },
    {
      "index": 20,
      "text": "Aus für sechs.",
      "file": "c020.ogg",
      "durationSec": 3.168
    },
    {
      "index": 21,
      "text": "[Pause:23]",
      "file": "c021.ogg",
      "durationSec": 23.0,
      "silence": true
    },
    {
      "index": 22,
      "text": "Atmen Sie noch einmal ruhig durch.",
      "file": "c022.ogg",
      "durationSec": 4.752
    },
    {
      "index": 23,
      "text": "Wackeln Sie mit den Fingern.",
      "file": "c023.ogg",
      "durationSec": 4.176
    },
    {
      "index": 24,
      "text": "Wenn Sie bereit sind, öffnen Sie die Augen.",
      "file": "c024.ogg",
      "durationSec": 5.688
    },
    {
      "index": 25,
      "text": "Tragen Sie ein wenig davon bei sich.",
      "file": "c025.ogg",
      "durationSec": 5.04
    }
  ]
}
