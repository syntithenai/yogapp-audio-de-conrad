{
  "id": "deep-rest-20",
  "voiceId": "de-conrad",
  "edgeVoice": "de-DE-ConradNeural",
  "rate": "-42%",
  "pitch": "-12Hz",
  "totalSec": 1487,
  "chunks": [
    {
      "index": 0,
      "text": "Willkommen in einer Praxis der tiefen Ruhe.",
      "file": "c000.ogg",
      "durationSec": 5.736
    },
    {
      "index": 1,
      "text": "Legen Sie sich, wenn möglich, auf den Rücken.",
      "file": "c001.ogg",
      "durationSec": 6.192
    },
    {
      "index": 2,
      "text": "Stützen Sie Kopf und Knie, wenn das hilft.",
      "file": "c002.ogg",
      "durationSec": 5.808
    },
    {
      "index": 3,
      "text": "Lassen Sie die Arme an Ihren Seiten ruhen, die Handflächen sind weich.",
      "file": "c003.ogg",
      "durationSec": 7.944
    },
    {
      "index": 4,
      "text": "Schließe die Augen.",
      "file": "c004.ogg",
      "durationSec": 3.456
    },
    {
      "index": 5,
      "text": "Es gibt keinen anderen Ort, an dem man sein kann.",
      "file": "c005.ogg",
      "durationSec": 6.432
    },
    {
      "index": 6,
      "text": "[Pause:23]",
      "file": "c006.ogg",
      "durationSec": 23.0,
      "silence": true
    },
    {
      "index": 7,
      "text": "Spüren Sie die Berührungspunkte mit dem Boden oder dem Bett.",
      "file": "c007.ogg",
      "durationSec": 6.744
    },
    {
      "index": 8,
      "text": "Absätze. Hüften. Schulterblätter. Kopf.",
      "file": "c008.ogg",
      "durationSec": 10.608
    },
    {
      "index": 9,
      "text": "Lassen Sie den Körper festhalten.",
      "file": "c009.ogg",
      "durationSec": 4.824
    },
    {
      "index": 10,
      "text": "[Pause:23]",
      "file": "c010.ogg",
      "durationSec": 23.0,
      "silence": true
    },
    {
      "index": 11,
      "text": "Beachten Sie den natürlichen Atem.",
      "file": "c011.ogg",
      "durationSec": 4.704
    },
    {
      "index": 12,
      "text": "Keine Notwendigkeit, es zu ändern.",
      "file": "c012.ogg",
      "durationSec": 5.76
    },
    {
      "index": 13,
      "text": "Einatmen kommt.",
      "file": "c013.ogg",
      "durationSec": 3.36
    },
    {
      "index": 14,
      "text": "Blätter ausatmen.",
      "file": "c014.ogg",
      "durationSec": 3.552
    },
    {
      "index": 15,
      "text": "[Pause:25]",
      "file": "c015.ogg",
      "durationSec": 25.0,
      "silence": true
    },
    {
      "index": 16,
      "text": "Wenn der Geist beschäftigt ist, ist das erlaubt.",
      "file": "c016.ogg",
      "durationSec": 6.288
    },
    {
      "index": 17,
      "text": "Du kannst dich trotzdem ausruhen.",
      "file": "c017.ogg",
      "durationSec": 4.656
    },
    {
      "index": 18,
      "text": "Kehren Sie einfach immer wieder zur Sensation zurück.",
      "file": "c018.ogg",
      "durationSec": 6.432
    },
    {
      "index": 19,
      "text": "[Pause:23]",
      "file": "c019.ogg",
      "durationSec": 23.0,
      "silence": true
    },
    {
      "index": 20,
      "text": "Bringen Sie die Aufmerksamkeit auf den rechten Fuß.",
      "file": "c020.ogg",
      "durationSec": 6.144
    },
    {
      "index": 21,
      "text": "Zehen. Sohle, einzig, alleinig. Ferse.",
      "file": "c021.ogg",
      "durationSec": 10.056
    },
    {
      "index": 22,
      "text": "[Pause:21]",
      "file": "c022.ogg",
      "durationSec": 21.0,
      "silence": true
    },
    {
      "index": 23,
      "text": "Rechter Unterschenkel.",
      "file": "c023.ogg",
      "durationSec": 3.768
    },
    {
      "index": 24,
      "text": "Knie.",
      "file": "c024.ogg",
      "durationSec": 2.328
    },
    {
      "index": 25,
      "text": "Oberschenkel.",
      "file": "c025.ogg",
      "durationSec": 3.072
    },
    {
      "index": 26,
      "text": "[Pause:21]",
      "file": "c026.ogg",
      "durationSec": 21.0,
      "silence": true
    },
    {
      "index": 27,
      "text": "Rechte Hüfte.",
      "file": "c027.ogg",
      "durationSec": 3.216
    },
    {
      "index": 28,
      "text": "Ganzes rechtes Bein, schwer und ruhig.",
      "file": "c028.ogg",
      "durationSec": 5.52
    },
    {
      "index": 29,
      "text": "[Pause:23]",
      "file": "c029.ogg",
      "durationSec": 23.0,
      "silence": true
    },
    {
      "index": 30,
      "text": "Linker Fuß.",
      "file": "c030.ogg",
      "durationSec": 3.048
    },
    {
      "index": 31,
      "text": "Zehen. Sohle, einzig, alleinig. Ferse.",
      "file": "c031.ogg",
      "durationSec": 10.056
    },
    {
      "index": 32,
      "text": "[Pause:21]",
      "file": "c032.ogg",
      "durationSec": 21.0,
      "silence": true
    },
    {
      "index": 33,
      "text": "Linker Unterschenkel.",
      "file": "c033.ogg",
      "durationSec": 3.72
    },
    {
      "index": 34,
      "text": "Knie.",
      "file": "c034.ogg",
      "durationSec": 2.328
    },
    {
      "index": 35,
      "text": "Oberschenkel.",
      "file": "c035.ogg",
      "durationSec": 3.072
    },
    {
      "index": 36,
      "text": "[Pause:21]",
      "file": "c036.ogg",
      "durationSec": 21.0,
      "silence": true
    },
    {
      "index": 37,
      "text": "Linke Hüfte.",
      "file": "c037.ogg",
      "durationSec": 3.216
    },
    {
      "index": 38,
      "text": "Ganzes linkes Bein, schwer und ruhig.",
      "file": "c038.ogg",
      "durationSec": 5.448
    },
    {
      "index": 39,
      "text": "[Pause:23]",
      "file": "c039.ogg",
      "durationSec": 23.0,
      "silence": true
    },
    {
      "index": 40,
      "text": "Becken und Unterbauch.",
      "file": "c040.ogg",
      "durationSec": 3.672
    },
    {
      "index": 41,
      "text": "Weich.",
      "file": "c041.ogg",
      "durationSec": 2.52
    },
    {
      "index": 42,
      "text": "[Pause:21]",
      "file": "c042.ogg",
      "durationSec": 21.0,
      "silence": true
    },
    {
      "index": 43,
      "text": "Heben und Senken der Brust.",
      "file": "c043.ogg",
      "durationSec": 4.176
    },
    {
      "index": 44,
      "text": "Herzraum offen und leicht.",
      "file": "c044.ogg",
      "durationSec": 4.176
    },
    {
      "index": 45,
      "text": "[Pause:23]",
      "file": "c045.ogg",
      "durationSec": 23.0,
      "silence": true
    },
    {
      "index": 46,
      "text": "Rechte Hand.",
      "file": "c046.ogg",
      "durationSec": 2.952
    },
    {
      "index": 47,
      "text": "Finger. Palme. Handgelenk.",
      "file": "c047.ogg",
      "durationSec": 7.68
    },
    {
      "index": 48,
      "text": "[Pause:14]",
      "file": "c048.ogg",
      "durationSec": 14.0,
      "silence": true
    },
    {
      "index": 49,
      "text": "Rechter Arm. Ellbogen. Schulter.",
      "file": "c049.ogg",
      "durationSec": 8.376
    },
    {
      "index": 50,
      "text": "[Pause:21]",
      "file": "c050.ogg",
      "durationSec": 21.0,
      "silence": true
    },
    {
      "index": 51,
      "text": "Linke Hand.",
      "file": "c051.ogg",
      "durationSec": 2.976
    },
    {
      "index": 52,
      "text": "Finger. Palme. Handgelenk.",
      "file": "c052.ogg",
      "durationSec": 7.68
    },
    {
      "index": 53,
      "text": "[Pause:14]",
      "file": "c053.ogg",
      "durationSec": 14.0,
      "silence": true
    },
    {
      "index": 54,
      "text": "Linker Arm. Ellbogen. Schulter.",
      "file": "c054.ogg",
      "durationSec": 8.16
    },
    {
      "index": 55,
      "text": "[Pause:23]",
      "file": "c055.ogg",
      "durationSec": 23.0,
      "silence": true
    },
    {
      "index": 56,
      "text": "Hals weich.",
      "file": "c056.ogg",
      "durationSec": 2.88
    },
    {
      "index": 57,
      "text": "Kiefer geöffnet.",
      "file": "c057.ogg",
      "durationSec": 3.312
    },
    {
      "index": 58,
      "text": "Zunge ruht.",
      "file": "c058.ogg",
      "durationSec": 2.856
    },
    {
      "index": 59,
      "text": "[Pause:21]",
      "file": "c059.ogg",
      "durationSec": 21.0,
      "silence": true
    },
    {
      "index": 60,
      "text": "Die Augen ruhen in ihren Augenhöhlen.",
      "file": "c060.ogg",
      "durationSec": 4.968
    },
    {
      "index": 61,
      "text": "Stirn glatt.",
      "file": "c061.ogg",
      "durationSec": 2.976
    },
    {
      "index": 62,
      "text": "Kopfhaut und Scheitel.",
      "file": "c062.ogg",
      "durationSec": 3.84
    },
    {
      "index": 63,
      "text": "[Pause:23]",
      "file": "c063.ogg",
      "durationSec": 23.0,
      "silence": true
    },
    {
      "index": 64,
      "text": "Spüren Sie den ganzen Körper als ein Feld der Stille.",
      "file": "c064.ogg",
      "durationSec": 6.528
    },
    {
      "index": 65,
      "text": "Der Atem strömte durch ihn hindurch wie eine stille Flut.",
      "file": "c065.ogg",
      "durationSec": 6.456
    },
    {
      "index": 66,
      "text": "[Pause:62]",
      "file": "c066.ogg",
      "durationSec": 62.0,
      "silence": true
    },
    {
      "index": 67,
      "text": "Bleiben Sie beim ganzen Körper.",
      "file": "c067.ogg",
      "durationSec": 4.512
    },
    {
      "index": 68,
      "text": "[Pause:105]",
      "file": "c068.ogg",
      "durationSec": 105.0,
      "silence": true
    },
    {
      "index": 69,
      "text": "Weich. Geräumig. Trotzdem.",
      "file": "c069.ogg",
      "durationSec": 7.8
    },
    {
      "index": 70,
      "text": "[Pause:55]",
      "file": "c070.ogg",
      "durationSec": 55.0,
      "silence": true
    },
    {
      "index": 71,
      "text": "Wenn ein Gedanke auftaucht, lass ihn wie eine Wolke vorüberziehen.",
      "file": "c071.ogg",
      "durationSec": 8.064
    },
    {
      "index": 72,
      "text": "[Pause:50]",
      "file": "c072.ogg",
      "durationSec": 50.0,
      "silence": true
    },
    {
      "index": 73,
      "text": "Kehren Sie zum Gefühl zurück, gehalten zu werden.",
      "file": "c073.ogg",
      "durationSec": 6.384
    },
    {
      "index": 74,
      "text": "[Pause:55]",
      "file": "c074.ogg",
      "durationSec": 55.0,
      "silence": true
    },
    {
      "index": 75,
      "text": "Ruhe hier.",
      "file": "c075.ogg",
      "durationSec": 2.952
    },
    {
      "index": 76,
      "text": "Nichts zu lösen.",
      "file": "c076.ogg",
      "durationSec": 3.336
    },
    {
      "index": 77,
      "text": "Nichts zu vervollständigen.",
      "file": "c077.ogg",
      "durationSec": 4.152
    },
    {
      "index": 78,
      "text": "[Pause:110]",
      "file": "c078.ogg",
      "durationSec": 110.0,
      "silence": true
    },
    {
      "index": 79,
      "text": "Wenn Sie driften, ist das in Ordnung.",
      "file": "c079.ogg",
      "durationSec": 5.496
    },
    {
      "index": 80,
      "text": "Wenn Sie aufmerksam bleiben, ist das auch in Ordnung.",
      "file": "c080.ogg",
      "durationSec": 6.84
    },
    {
      "index": 81,
      "text": "Beides ist Ruhe.",
      "file": "c081.ogg",
      "durationSec": 3.48
    },
    {
      "index": 82,
      "text": "[Pause:130]",
      "file": "c082.ogg",
      "durationSec": 130.0,
      "silence": true
    },
    {
      "index": 83,
      "text": "Ausruhen.",
      "file": "c083.ogg",
      "durationSec": 2.808
    },
    {
      "index": 84,
      "text": "[Pause:115]",
      "file": "c084.ogg",
      "durationSec": 115.0,
      "silence": true
    },
    {
      "index": 85,
      "text": "Beginnen Sie wieder, den Atem wahrzunehmen.",
      "file": "c085.ogg",
      "durationSec": 5.928
    },
    {
      "index": 86,
      "text": "Jetzt etwas lebendiger.",
      "file": "c086.ogg",
      "durationSec": 4.296
    },
    {
      "index": 87,
      "text": "[Pause:23]",
      "file": "c087.ogg",
      "durationSec": 23.0,
      "silence": true
    },
    {
      "index": 88,
      "text": "Spüren Sie den Raum um Sie herum.",
      "file": "c088.ogg",
      "durationSec": 4.776
    },
    {
      "index": 89,
      "text": "Klingt nah und fern.",
      "file": "c089.ogg",
      "durationSec": 3.6
    },
    {
      "index": 90,
      "text": "[Pause:21]",
      "file": "c090.ogg",
      "durationSec": 21.0,
      "silence": true
    },
    {
      "index": 91,
      "text": "Wackeln Sie mit den Fingern.",
      "file": "c091.ogg",
      "durationSec": 4.176
    },
    {
      "index": 92,
      "text": "Wackeln Sie mit den Zehen.",
      "file": "c092.ogg",
      "durationSec": 4.032
    },
    {
      "index": 93,
      "text": "Rollen Sie die Handgelenke und Knöchel, wenn Sie möchten.",
      "file": "c093.ogg",
      "durationSec": 6.672
    },
    {
      "index": 94,
      "text": "[Pause:21]",
      "file": "c094.ogg",
      "durationSec": 21.0,
      "silence": true
    },
    {
      "index": 95,
      "text": "Atmen Sie tiefer ein.",
      "file": "c095.ogg",
      "durationSec": 3.792
    },
    {
      "index": 96,
      "text": "Und ein langer Seufzer.",
      "file": "c096.ogg",
      "durationSec": 3.96
    },
    {
      "index": 97,
      "text": "Wenn Sie bereit sind, öffnen Sie die Augen.",
      "file": "c097.ogg",
      "durationSec": 5.688
    },
    {
      "index": 98,
      "text": "Kehren Sie langsam zurück.",
      "file": "c098.ogg",
      "durationSec": 4.008
    },
    {
      "index": 99,
      "text": "Tragen Sie ein wenig von dieser Stille bei sich.",
      "file": "c099.ogg",
      "durationSec": 5.904
    }
  ]
}
